# PulseCare Frontend Environment Configuration

# Optional: URL of your deployed backend service (e.g. Render, Railway, Fly.io)
# Example: https://pulsecare-backend.onrender.com
# If omitted or left empty, API requests will use the relative '/api' path.
VITE_API_URL=

# Optional: Dedicated WebSocket URL
# Example: wss://pulsecare-backend.onrender.com/ws
# If omitted, it will automatically be derived from VITE_API_URL.
VITE_WS_URL=
