# PulseCare Backend Environment
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsecare

# Redis
REDIS_URL=redis://localhost:6379

# AI API Keys (use whichever provider you have)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# AI Provider: openai | gemini | anthropic
AI_PROVIDER=gemini

# Gemini models (automatic fallback on quota exceeded / 429)
# Tries primary → fallback_1 → fallback_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK_1=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK_2=gemini-3.8-flash

# Synthetic data settings
SEED_FACILITY_COUNT=25
SIMULATION_INTERVAL_MS=5000
