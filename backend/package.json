{
  "name": "backend",
  "version": "1.0.0",
  "description": "PulseCare - Federated AI Platform for PHC Resource Management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:seed": "tsx src/server.ts --reset --seed --simulate",
    "dev:simulate": "tsx src/server.ts --simulate",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/run-seed.ts",
    "seed:reset": "tsx src/seed/run-seed.ts --reset",
    "migrate": "tsx -e \"require('./src/db/migrations').runMigrations().then(() => process.exit(0))\"",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "typescript": "^5.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  }
}
